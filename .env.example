# SORO Fabrications — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# ==========================================
# EmailJS Configuration (Quotation Form)
# Get credentials from https://www.emailjs.com
# ==========================================
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_QUOTE_TEMPLATE_ID=your_quote_template_id_here
VITE_EMAILJS_CONTACT_TEMPLATE_ID=your_contact_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# ==========================================
# Company Contact Details
# Update these when the verified details are available
# ==========================================
VITE_COMPANY_EMAIL=orders@sorofabrication.in
VITE_COMPANY_PHONE=+91XXXXXXXXXX
VITE_COMPANY_WHATSAPP=+91XXXXXXXXXX
VITE_COMPANY_ADDRESS=Your Company Address, City, State, PIN, India

# ==========================================
# Site Configuration
# ==========================================
VITE_SITE_URL=https://sorofabrications.com
