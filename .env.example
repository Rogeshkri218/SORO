# Frontend values (public; do not put secrets in VITE_ variables)
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:5000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_STORAGE_BUCKET=soro-project-files

# Existing public company/site details
VITE_COMPANY_EMAIL=orders@sorofabrication.in
VITE_COMPANY_PHONE=+91XXXXXXXXXX
VITE_COMPANY_WHATSAPP=+91XXXXXXXXXX
VITE_COMPANY_ADDRESS=Your Company Address, City, State, PIN, India
VITE_SITE_URL=https://sorofabrications.com

# Backend-only values: configure in the root .env locally and Render environment settings.
NODE_ENV=development
PORT=5000
MONGODB_URI=your_mongodb_atlas_connection_string
MONGODB_DB_NAME=soro
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=
CUSTOMER_TOKEN_SECRET=
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_private_server_side_key
SUPABASE_STORAGE_BUCKET=soro-project-files
MAX_UPLOAD_FILE_BYTES=104857600
MAX_UPLOAD_TOTAL_BYTES=524288000
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=verified_sender_address
ENQUIRY_RECIPIENT_VERIFIED=false
TRUST_PROXY_HOPS=1
PUBLIC_API_RATE_LIMIT=30
