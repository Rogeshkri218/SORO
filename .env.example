# SORO Fabrications — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# ==========================================
# Server-side website enquiry email delivery
# Configure these in the server environment (for example, Vercel project settings).
# Never add the Resend API key to a VITE_ variable.
# ==========================================
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
# Comma-separated exact origins; include localhost only for local development.
ENQUIRY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public company contact details
VITE_COMPANY_EMAIL=orders@sorofabrication.in
VITE_COMPANY_PHONE=+91XXXXXXXXXX
VITE_COMPANY_WHATSAPP=+91XXXXXXXXXX
VITE_COMPANY_ADDRESS=Your Company Address, City, State, PIN, India

# ==========================================
# Site Configuration
# ==========================================
VITE_SITE_URL=https://sorofabrications.com
